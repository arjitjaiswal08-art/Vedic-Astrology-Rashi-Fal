# ═══════════════════════════════════════════════════════════════════════════════
# Vedic Astrology & PanditConnect — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and provide your actual secrets.
# NEVER commit real production secrets to version control.

# Server Configuration
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Authentication & Session Security (Change in production!)
JWT_SECRET=vedic-astrology-jwt-secret-secure-random-key-change-in-prod
JWT_REFRESH_SECRET=vedic-astrology-refresh-secret-secure-random-key-change-in-prod

# ═══════════════════════════════════════════════════════════════════════════════
# Razorpay Standard Checkout & Payment Gateway Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Sign up at https://dashboard.razorpay.com and generate API Keys:
# Dashboard -> Settings -> API Keys (Generate Test Key)
#
# Use Test Mode Keys for local development and QA staging:
# Test Key format: rzp_test_xxxxxxxxxxxxxxxx
# Live Key format: rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# Razorpay Webhook Secret
# Configure in Razorpay Dashboard: Settings -> Webhooks -> Add New Webhook
# Webhook URL: https://yourdomain.com/api/webhooks/razorpay
# Events to subscribe:
#   - payment.captured
#   - payment.failed
#   - order.paid
#   - refund.processed
#   - refund.failed
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# Platform Business Configuration
PLATFORM_FEE_INR=49
GST_PERCENT=18
DEFAULT_CURRENCY=INR

# ═══════════════════════════════════════════════════════════════════════════════
# Google OAuth Configuration (Google Identity Services)
# ═══════════════════════════════════════════════════════════════════════════════
# Obtain Client ID from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

